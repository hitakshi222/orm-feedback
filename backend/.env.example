SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Choose exactly one backend by setting DB_BACKEND. The connection URL matching
# DB_BACKEND is used; uncomment one of the alternative DB_BACKEND lines to switch.
DB_BACKEND=sqlserver
#DB_BACKEND=mysql
#DB_BACKEND=postgresql

# SQL Server (local SQL Server Engine; create database/login before starting).
SQLSERVER_DB_URL=mssql+pyodbc://YOUR_SQLSERVER_USER:YOUR_URL_ENCODED_PASSWORD@localhost:1433/biyani_feedback?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# MySQL (set DB_BACKEND=mysql above and fill in actual server credentials).
#MYSQL_DB_URL=mysql+pymysql://YOUR_MYSQL_USER:YOUR_URL_ENCODED_PASSWORD@localhost:3306/biyani_feedback

# PostgreSQL (set DB_BACKEND=postgresql above and fill in actual credentials).
#DB_URL=postgresql+psycopg://YOUR_POSTGRES_USER:YOUR_URL_ENCODED_PASSWORD@localhost:5432/biyani_feedback
